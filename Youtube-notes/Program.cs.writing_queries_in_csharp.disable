
using System.ComponentModel.Design;
using Type;

Category?[] categories =
[
    new("mobile",1),
    null,
    new("laptop",2),
    null,
    new("tv",3)
];

Product?[] products = [
    new Product("samsumng",1),
    new Product("mi",2),
    new Product("vivo",3),
    null,
    new Product("nokia",4),
    new Product("apple",5),
    null,
    new Product("bajaj",6),
    new Product("blackbarry",7),
    new Product("xiome",8),
];

var query1 = from c in categories
             where c != null
             join p in products on c.ID equals p?.CategoryID
             select new
             {
                 Category = c.Name,
                 Name = p.Name
             };

