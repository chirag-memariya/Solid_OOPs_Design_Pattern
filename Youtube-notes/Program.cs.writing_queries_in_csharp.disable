var studentQuery =
    from student in students
    let totalScore = student.Scores[0] + student.Scores[1] +
            student.Scores[2] + student.Scores[2]
    select totalScore;

Console.WriteLine("totalScore : " + studentQuery.ToList());

var average = studentQuery.Average();

Console.WriteLine("average : " + average);


var aboveAverageQuery =
    from student in students
    let x = student.Scores[0] + student.Scores[1] + student.Scores[2] + student.Scores[3]
    where x > average
    select student;

foreach(var s in aboveAverageQuery)
{
    Console.WriteLine($"{s.First} {s.Last}");
    foreach (var score in s.Scores)
    {
        Console.Write(score + " ");
    }
    Console.WriteLine();
}