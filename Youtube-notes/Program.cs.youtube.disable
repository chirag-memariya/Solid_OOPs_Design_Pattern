                    where p.Pets.Any(pet => pet is Dog)
                    select p;

var result2 = people.Where(p => p.Pets.Any(pet => pet is Cat))
                    .OrderBy(p => p.Pets
                        .Where(pet=> pet is Cat)
                        .Select(pet => pet.First)
                        .Min()
                    );

PrintCollection(result2);


static void PrintCollection(IEnumerable<Person> people)
{
    Console.WriteLine($"Start.............................");
    foreach (var person in people)
    {
        Console.WriteLine(person);
        foreach (var pet in person.Pets)
        {
            Console.WriteLine($"   {pet}");
        }
    }
    Console.WriteLine($"End ..............................");

}
public class Person
{

    public Person(string firstname, string lastname, DateOnly birthdate)
    {
        FirstName = firstname;
        LastName = lastname;
        Birthdate = birthdate;
    }

    private string FirstName { get; }
    private string LastName { get; }
    private DateOnly Birthdate { get; }

    public List<Pet> Pets = new();

    public override string ToString()
    {
        return $"Human {FirstName} {LastName} have a ";
    }

}

public abstract class Pet(string first)
{
    public string First { get; } = first;
    public abstract string MakeNoice();
    public override string ToString()
    {
        return $"{GetType().Name} : {First} And It {MakeNoice()}.";
    }
}

public class Cat(string firstname) : Pet(firstname)
{
    public override string MakeNoice() => "meow";
}

public class Dog(string firstname) : Pet(firstname)
{
    public override string MakeNoice() => "bark";
}